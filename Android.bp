soong_namespace {
    imports: [
        "device/xiaomi/sm8550-common",
        "hardware/qcom-caf/sm8550",
        "hardware/xiaomi",
        // libmisoundsa is declared by the main sm8550-common vendor tree
        "vendor/xiaomi/sm8550-common",
    ],
}

// Dolby audio prebuilts for fuxi.
//
// ELF files are installed as Soong prebuilt modules rather than through
// PRODUCT_COPY_FILES: Android 17 rejects ELF files copied that way
// ("found ELF prebuilt in PRODUCT_COPY_FILES").
//
// Each module lists the exact DT_NEEDED entries of its blob; Soong enforces
// that the declared shared_libs match the binary's DT_NEEDED table.

cc_prebuilt_library_shared {
    name: "libdlbvol",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/soundfx/libdlbvol.so",
            ],
            shared_libs: [
                "liblog",
                "libutils",
                "libcutils",
                "libaudioutils",
                "libstagefright_foundation",
                "libdlbpreg",
                "vendor.dolby.hardware.dms@2.0",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    relative_install_path: "soundfx",
    prefer: true,
    soc_specific: true,
}

